{
  "name": "forup-lead-forge-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src scripts --max-warnings 0",
    "lint:fix": "eslint src scripts --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test dist/tests/*.test.js",
    "audit:ci": "npm audit --audit-level=high",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "create-admin": "node scripts/createAdminUser.js",
    "fix:pillars": "node scripts/fixCoursePillars.js",
    "seed:valores-humanos": "node scripts/seedValoresHumanos.js",
    "seed:course-content": "node scripts/seedValoresHumanos.js",
    "update:valores-humanos": "node scripts/updateValoresHumanosDescription.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.110.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "prisma": "^5.22.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3"
  }
}
