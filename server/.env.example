# Backend environment example.
# Copy to .env locally and fill real values outside Git.

NODE_ENV=development
PORT=4010
TRUST_PROXY_HOPS=0
PUBLIC_BASE_URL=http://localhost:4010
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,X-CSRF-Token
CORS_PREFLIGHT_MAX_AGE_SECONDS=600
CORS_ALLOW_NON_BROWSER_REQUESTS=false

DATABASE_URL=replace-with-postgres-database-url
DIRECT_URL=replace-with-postgres-direct-url

STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# Required when STORAGE_DRIVER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=courses

# Required when STORAGE_DRIVER=s3
AWS_REGION=auto
AWS_S3_ENDPOINT=https://example.r2.cloudflarestorage.com
AWS_S3_BUCKET=replace-with-bucket-name
AWS_S3_BASE_URL=https://cdn.example.com
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

GOOGLE_SHEETS_CLIENT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY=replace-with-google-private-key-pem
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEETS_LEADS_SHEET_NAME=Leads

ADMIN_TOKEN_SECRET=replace-with-random-32-plus-character-secret

# Rate limiting
# In production, configure a shared Redis store so limits work across instances.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LEADS_WINDOW_MS=600000
RATE_LIMIT_LEADS_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_IMAGE_PROXY_WINDOW_MS=60000
RATE_LIMIT_IMAGE_PROXY_MAX=120
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=120

# Public lead anti-abuse controls
# Use turnstile or hcaptcha in production. Keep disabled only for local/test environments.
CAPTCHA_PROVIDER=disabled
CAPTCHA_SECRET_KEY=replace-with-captcha-secret-key
# CAPTCHA_VERIFY_URL can override the provider default for tests or private egress proxies.
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
LEAD_DEDUP_WINDOW_MS=86400000
