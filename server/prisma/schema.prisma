generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id          String        @id
  name        String
  description String?
  fields      String?
  images      CourseImage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CourseImage {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  url        String
  storageKey String?
  createdAt  DateTime @default(now())
}
